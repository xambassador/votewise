{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES6",
    "jsx": "preserve",
    "resolveJsonModule": true,
    "lib": ["DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": false,
    "incremental": true,
    "composite": true
  },
  "references": [{ "path": "../../services/api" }],
  "include": ["./src/**/*"],
  "exclude": ["dist", "build", "node_modules"]
}
