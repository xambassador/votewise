{
  "name": "votewise",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/common/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "web:build": "turbo run build --filter=@votewise/web",
    "web:dev": "turbo run dev --filter=@votewise/web",
    "api:start": "turbo run start --filter=@votewise/api",
    "api:dev": "turbo run dev --filter=@votewise/api",
    "api:build": "turbo run build --filter=@votewise/api",
    "api:test": "turbo run test --filter=@votewise/api",
    "api:test:watch": "turbo run test:watch --filter=@votewise/api",
    "upload:start": "turbo run start --filter=@votewise/upload",
    "upload:dev": "turbo run dev --filter=@votewise/upload",
    "upload:build": "turbo run build --filter=@votewise/upload",
    "db:migrate": "turbo run db:migrate --filter=@votewise/db",
    "db:seed": "turbo run db:seed --filter=@votewise/db",
    "db:clean": "turbo run db:clean --filter=@votewise/db",
    "clean": "turbo run clean",
    "clean:build": "turbo run clean:build",
    "dev": "turbo run dev --filter=@votewise/web --filter=@votewise/api --filter=@votewise/upload",
    "dev:all": "turbo run dev",
    "start": "turbo run start",
    "build": "turbo run build",
    "storybook": "turbo run storybook",
    "storybook:build": "turbo run storybook:build",
    "graph": "turbo run build --graph",
    "format": "prettier . --write \"**/*.{ts,tsx,md}\" --cache",
    "format:check": "prettier . --check \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint --continue",
    "lint:fix": "turbo run lint --continue -- --fix",
    "lint:report": "turbo run lint --continue -- --report",
    "prepare": "husky",
    "prepack": "husky",
    "commit": "cz"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@commitlint/cz-commitlint": "^19.4.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@total-typescript/ts-reset": "^0.5.1",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "commitizen": "^4.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.6",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-es": "^4.1.0",
    "eslint-plugin-functional": "^6.6.3",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-tailwindcss": "^3.17.4",
    "eslint-plugin-unused-imports": "^4.1.3",
    "husky": "^9.1.5",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.1.0",
    "tailwindcss": "3.4.10",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.12",
    "turbo": "^2.10.9",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20",
    "yarn": ">=4.0.2"
  },
  "packageManager": "yarn@4.0.2",
  "lint-staged": {
    "*": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern",
    "*.{json,md,yml}": "prettier --write",
    "*.{js,jsx,ts,tsx}": "eslint"
  }
}
